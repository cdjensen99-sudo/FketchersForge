<Project>
  <PropertyGroup>
    <!-- Valheim 1.0.7 / Unity 6 game assemblies -->
    <ValheimPath Condition="'$(ValheimPath)' == ''">D:\SteamLibrary\steamapps\common\Valheim</ValheimPath>
    <ValheimManaged>$(ValheimPath)\valheim_Data\Managed</ValheimManaged>

    <!-- Gale "New Release" profile: BepInExPack 5.4.2350 (Unity 6) + Jotunn -->
    <GaleProfile Condition="'$(GaleProfile)' == ''">$(USERPROFILE)\AppData\Roaming\com.kesomannen.gale\valheim\profiles\New Release</GaleProfile>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(GaleProfile)\BepInEx</BepInExPath>
    <BepInExCore>$(BepInExPath)\core</BepInExCore>
    <JotunnPath Condition="'$(JotunnPath)' == ''">$(GaleProfile)\BepInEx\plugins\ValheimModding-Jotunn\Jotunn.dll</JotunnPath>

    <ModVersion>1.0.0</ModVersion>
    <ModDeployDir>$(GaleProfile)\BepInEx\plugins\Hardwire99-FletchersForge</ModDeployDir>
  </PropertyGroup>
</Project>
